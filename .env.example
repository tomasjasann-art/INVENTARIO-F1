DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# La integración también puede entregar SUPABASE_URL y POSTGRES_URL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# Dominio técnico interno: no se muestra al usuario ni requiere un buzón real.
F1_AUTH_DOMAIN=acceso.f1.services
# Clerk queda temporalmente como acceso anterior de respaldo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
F1_ADMIN_EMAILS=admin@example.com
